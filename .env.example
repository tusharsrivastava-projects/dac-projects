# ── DAC HRM Platform ────────────────────────────────────────────────────────
# Copy to .env and adjust. Everything here has a working default, so the app
# runs with no .env at all — you only need this for production.

PORT=4000
HOST=0.0.0.0

# Where the SQLite file and uploaded recordings live.
DATA_DIR=./data

# Public base URL. Offer links are built from this, so it must be the address
# candidates can actually reach. Leave blank to infer it from the request.
BASE_URL=

# Session cookies. Turn COOKIE_SECURE on once you are behind HTTPS.
SESSION_DAYS=7
COOKIE_SECURE=false

# Largest recording accepted per answer.
MAX_AUDIO_MB=25

# ── Mail ────────────────────────────────────────────────────────────────────
# Without SMTP_HOST, every letter and notification is written to the in-app
# Mail outbox instead of being delivered. The hiring flow still works end to
# end — admins can copy the offer link straight out of the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DAC Talent <no-reply@dgu-ai-cell.local>

# ── Branding on offer letters ───────────────────────────────────────────────
ORG_NAME=DAC — DGU AI Cell
ORG_PARENT=DBS Global University
ORG_ADDRESS=Dehradun, Uttarakhand, India
ORG_SIGNATORY=Head of Talent
ORG_SIGNATORY_NAME=DAC Hiring Office
ORG_WEBSITE=https://dgu.ac.in

# ── First admin account (used by `npm run seed`) ────────────────────────────
# Change the password before you put this anywhere real.
ADMIN_EMAIL=admin@dgu.ac.in
ADMIN_PASSWORD=dac-admin-2026
ADMIN_NAME=DAC Administrator

# ── DAC HRM Platform ────────────────────────────────────────────────────────
# Copy to .env and adjust. Everything here has a working default, so the app
# runs with no .env at all — you only need this for production.

PORT=4000
HOST=0.0.0.0

# Where the SQLite file and uploaded recordings live.
DATA_DIR=./data

# Public base URL. Offer links are built from this, so it must be the address
# candidates can actually reach. Leave blank to infer it from the request —
# on Render, RENDER_EXTERNAL_URL is picked up automatically.
BASE_URL=

# An empty database seeds itself on first boot so a fresh deploy has a way in.
# SEED_DEMO_DATA=false skips the sample roles; AUTO_BOOTSTRAP=false turns the
# whole thing off. Neither ever touches a database that already has users.
SEED_DEMO_DATA=true
AUTO_BOOTSTRAP=true

# Session cookies. Turn COOKIE_SECURE on once you are behind HTTPS.
SESSION_DAYS=7
COOKIE_SECURE=false

# Largest recording accepted per answer.
MAX_AUDIO_MB=25

# ── Where recordings are stored ─────────────────────────────────────────────
# 'local' writes to DATA_DIR/uploads. 'drive' files each answer into a Google
# Drive folder you own, one subfolder per candidate, so the panel can also just
# open Drive and listen. Use 'drive' anywhere the disk is not persistent.
STORAGE_DRIVER=local

# Leave GDRIVE_FOLDER_ID blank and the app creates its own folder on first use
# (named below) — that works with the narrow drive.file scope. Set it to an
# existing folder's id only if you also grant the full 'drive' scope.
GDRIVE_FOLDER_ID=
GDRIVE_FOLDER_NAME=DAC Interview Submissions
# Keep a copy on local disk as well. Only worth it if that disk persists.
GDRIVE_KEEP_LOCAL_COPY=false

# Run `npm run google-auth` to get these. It walks the consent flow and prints
# them. The refresh token is a credential — treat it like a password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Alternative to the three above, and ONLY for a Shared Drive: a service
# account key, as raw JSON or base64. Service accounts have no storage quota,
# so uploads into a personal My Drive folder fail however you share it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Mail ────────────────────────────────────────────────────────────────────
# Without SMTP_HOST, every letter and notification is written to the in-app
# Mail outbox instead of being delivered. The hiring flow still works end to
# end — admins can copy the offer link straight out of the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DAC Talent <no-reply@dgu-ai-cell.local>

# ── Branding on offer letters ───────────────────────────────────────────────
ORG_NAME=DAC — DGU AI Cell
ORG_PARENT=DBS Global University
ORG_ADDRESS=Dehradun, Uttarakhand, India
ORG_SIGNATORY=Head of Talent
ORG_SIGNATORY_NAME=DAC Hiring Office
ORG_WEBSITE=https://dgu.ac.in

# ── First admin account (used by `npm run seed`) ────────────────────────────
# Change the password before you put this anywhere real.
ADMIN_EMAIL=admin@dgu.ac.in
ADMIN_PASSWORD=dac-admin-2026
ADMIN_NAME=DAC Administrator

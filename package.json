{
  "name": "dac-hrm-platform",
  "version": "1.0.0",
  "private": true,
  "description": "DAC (DGU AI Cell) HRM platform - hiring, async audio interviews, admin review and offer letters.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",

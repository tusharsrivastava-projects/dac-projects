    "test:ui": "bash test/run-ui.sh",
    "google-auth": "node scripts/google-auth.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10"
  }
}

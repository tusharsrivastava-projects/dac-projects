# ── Subtize.ai ──────────────────────────────────────────────────────────────
# Copy to .env and adjust. Everything has a working default, so the app runs
# with no .env at all locally. For production, set the ones marked (!).

PORT=4600
HOST=0.0.0.0
NODE_ENV=production

# Where the SQLite file, the encryption key file (if DATA_KEY is unset) and
# uploads live. Point it at a persistent disk in production.
DATA_DIR=./data

# (!) Public address. Card QR codes, share links and referral links use it.
# On Render, RENDER_EXTERNAL_URL is picked up automatically.
BASE_URL=

# (!) 64 hex characters. Encrypts lister bank account numbers, ID numbers and
# settlement UPI handles at rest. Generate: openssl rand -hex 32
# Keep it safe: lose it and those fields can no longer be read.
DATA_KEY=

# (!) The first admin, created on an empty database. Never commit a real one.
ADMIN_EMAIL=admin@subtize.ai
ADMIN_PASSWORD=
ADMIN_NAME=Subtize Administrator

# An empty database seeds itself on first boot (categories, areas, admin).
# SEED_DEMO_DATA=true adds the demo catalogue of 105 services with listers,
# members and payments. Neither touches a database that already has users.
AUTO_BOOTSTRAP=true
SEED_DEMO_DATA=false

# Sessions. Turn COOKIE_SECURE on once you are behind HTTPS.
SESSION_DAYS=14
COOKIE_SECURE=false

# ── Payments ────────────────────────────────────────────────────────────────
# The official collection account every checkout QR points at. Admins can
# change these in Settings, and give any service its own official VPA.
PLATFORM_UPI_ID=subtize.collect@okaxis
PLATFORM_PAYEE=Subtize.ai Payments
COMMISSION_PERCENT=20

SUPPORT_EMAIL=support@subtize.ai
SUPPORT_PHONE=+91 135 000 0000
DEFAULT_CITY=Dehradun

# ── Email (OTP codes, notices) ──────────────────────────────────────────────
# Without SMTP, messages go to the admin console's outbox and — outside
# production only — sign-up codes are shown on screen so the flow still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Subtize.ai <no-reply@subtize.ai>

# ── AI search (optional) ────────────────────────────────────────────────────
# With a key, Claude reads each search / voice request; without one, the
# built-in parser handles it. Either way the result is checked against the
# real catalogue, and a failed call falls back to the parser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

MAX_UPLOAD_MB=5
